source "https://rubygems.org"
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby "3.3.1"

# Rails 8.0.x. This variant exists to measure extraction at scale (#2), not to
# cover a Rails version — the version matrix is the small variants' job.
gem "rails", "~> 8.0.0"

gem "sqlite3", "~> 2.1"
gem "puma", ">= 6.0"
gem "bootsnap", ">= 1.18.0", require: false

# Woods gem — bind-mounted by the testbed compose file.
gem "woods", path: "/woods-gem"

# ── Kernel dependencies (see KERNEL_CONTRACT.md) ──────────────────────────
# Added in one batch rather than per rung: every Gemfile change costs a
# bundle install, and behind an intercepting proxy that install needs the
# ccr overlay. One boot beats four. Each of these is inert until the kernel
# file that uses it exists.
gem "aasm"                      # state_machine units
gem "pundit"                    # pundit_policy units
gem "view_component"            # view_component units
gem "phlex-rails"               # component units
gem "scenic"                    # database_view units (db/views/*.sql)
# graphql_type / graphql_mutation / graphql_resolver units.
#
# GraphQLExtractor's file pass is deliberately NOT gated on this gem being
# loaded (graphql_source_present?, not graphql_available?), so app/graphql is
# indexed either way. It is installed here so eager_load doesn't hit a NameError
# and fall back to per-directory loading, which would make every timing number
# in this variant describe a degraded run. The gem-absent scenario is a separate
# axis — see KERNEL_CONTRACT.md and woods B-066 / #167.
gem "graphql"

group :development, :test do
  gem "rspec-rails"             # test_mapping units (spec/**/*_spec.rb)
  gem "factory_bot_rails"       # factory units (spec/factories/*.rb)
end
