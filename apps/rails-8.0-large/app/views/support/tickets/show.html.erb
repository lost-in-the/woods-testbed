<h1><%= @ticket.title %></h1><p><%= link_to @ticket.subscriber.name, subscriber_path(@ticket.subscriber) %> · <%= @ticket.state %> · <%= @ticket.assignee&.name || 'Unassigned' %></p><% if @ticket.subject.is_a?(Billing::Invoice) %><%= link_to 'Related invoice', billing_invoice_path(@ticket.subject) %><% end %><% @ticket.messages.each do |message| %><section><small><%= message.author&.name || 'Subscriber' %></small><%= simple_format message.body %></section><% end %><%= form_with url: support_ticket_path(@ticket), method: :patch do |f| %><%= f.label :body, 'Reply' %><%= f.text_area :body %><%= f.label :assignee_id, 'Assign editor' %><%= f.select :assignee_id, current_organization.memberships.where(role: 'editor').includes(:author).map { |m| [m.author.name, m.author_id] }, include_blank: true %><label><%= f.check_box :resolve %> Resolve ticket</label><%= f.submit 'Update ticket' %><% end %>
