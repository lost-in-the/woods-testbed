<h1>A place for stories to grow.</h1><p>Choose an editorial identity to explore publications, review stories, and manage a publishing business.</p>
<section><h2>Enter the demo</h2><%= form_with url: demo_session_path do |f| %><%= f.label :author_id, 'Identity' %><%= f.select :author_id, @authors.map { |a| ["#{a.name} · #{a.email}", a.id] } %> <%= f.submit 'Open publishing desk' %><% end %></section>
<% if current_author %><section><h2>Switch organization</h2><%= form_with url: demo_session_path, method: :patch do |f| %><%= f.select :organization_id, current_author.organizations.map { |o| [o.name, o.id] } %> <%= f.submit 'Switch' %><% end %></section><% end %>
