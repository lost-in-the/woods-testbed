<h1>Syndication partners</h1><table><thead><tr><th>Name</th><th>Contact</th><th>Status</th></tr></thead><tbody><% @partners.each do |partner| %><tr><td><%= link_to partner.name, syndication_partner_path(partner) %></td><td><%= partner.contact_email %></td><td><%= render StatusBadgeComponent.new(status: partner.status) %></td></tr><% end %></tbody></table><%= render 'shared/pagination', size: @partners.size %>
<h2>Add partner</h2><%= form_with url: syndication_partners_path do |f| %><%= f.label :name %><%= f.text_field :name, required: true %><%= f.label :contact_email %><%= f.email_field :contact_email, required: true %> <%= f.submit 'Add partner' %><% end %>
