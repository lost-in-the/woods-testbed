<h1><%= @partner.name %></h1><p><%= @partner.contact_email %> · <%= render StatusBadgeComponent.new(status: @partner.status) %></p>
<h2>Licenses</h2><table><thead><tr><th>Story</th><th>Territory</th><th>Dates</th><th>Fee</th><th></th></tr></thead><tbody><% @licenses.each do |license| %><tr><td><%= license.article.title %><% if license.exclusive? %> <span class="badge">Exclusive</span><% end %></td><td><%= license.territory %></td><td><%= license.starts_on %> to <%= license.ends_on %></td><td><%= render MoneyComponent.new(cents: license.fee_cents, currency: license.currency) %></td><td><%= button_to 'Revoke', revoke_syndication_license_path(license) %></td></tr><% end %></tbody></table>
<h2>Grant a license</h2><%= form_with url: syndication_licenses_path do |f| %><%= f.hidden_field :partner_id, value: @partner.id %><%= f.label :article_id, 'Story' %><%= f.select :article_id, @articles.map { |a| [a.title, a.id] } %><%= f.label :territory %><%= f.text_field :territory, value: 'worldwide', required: true %><%= f.label :starts_on %><%= f.date_field :starts_on, value: Date.current, required: true %><%= f.label :ends_on %><%= f.date_field :ends_on, value: Date.current + 365, required: true %><%= f.label :fee_cents, 'Fee in cents' %><%= f.number_field :fee_cents, min: 0, required: true %><%= f.label :exclusive %><%= f.check_box :exclusive, {}, '1', '0' %> <%= f.submit 'Grant license' %><% end %>
