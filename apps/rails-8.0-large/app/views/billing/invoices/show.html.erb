<h1><%= @invoice.reference %></h1><p><%= link_to @invoice.subscriber.name, subscriber_path(@invoice.subscriber) %> · <%= @invoice.settled_at ? 'Paid' : 'Outstanding' %> · <%= @invoice.currency %></p><section><% @invoice.line_items.each do |item| %><p><%= item.description %> — $<%= '%.2f' % (item.amount_cents / 100.0) %></p><% end %><strong>Total $<%= '%.2f' % (@invoice.total_cents / 100.0) %></strong></section>
<% unless @invoice.settled_at %><h2>Simulate payment</h2><%= form_with url: pay_billing_invoice_path(@invoice) do |f| %><%= f.hidden_field :key, value: SecureRandom.uuid %><%= f.select :outcome, [['Successful payment', 'success'], ['Declined payment', 'failure']] %><%= f.select :method, [['Card', 'card'], ['Bank', 'bank']] %> <%= f.submit 'Run payment' %><% end %><% end %>
<h2>Payment history</h2><% @invoice.payments.each do |payment| %><section><p><%= payment.type %> · <%= payment.state %> · $<%= '%.2f' % (payment.amount_cents / 100.0) %></p><% payment.refunds.each do |refund| %><p>Refund: $<%= '%.2f' % (refund.amount_cents / 100.0) %> · <%= refund.reason %></p><% end %><% if payment.state == 'captured' %><%= form_with url: refund_billing_invoice_path(@invoice) do |f| %><%= f.hidden_field :payment_id, value: payment.id %><%= f.hidden_field :key, value: SecureRandom.uuid %><%= f.label :amount_cents, 'Refund amount in cents' %><%= f.number_field :amount_cents, min: 1, required: true %><%= f.label :reason %><%= f.text_field :reason, required: true %> <%= f.submit 'Issue refund' %><% end %><% end %></section><% end %>
