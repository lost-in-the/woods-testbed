<p><%= link_to '← Editorial', articles_path %></p><h1><%= @article.title %></h1><p><%= @article.author.name %> · <%= @article.publication.name %> · <span class="badge"><%= @article.state.humanize %></span></p>
<section><%= simple_format @article.body %></section><p><%= link_to "Discussion (#{@article.comments_count})", article_comments_path(@article) %> · <%= @article.word_count %> words <% if @article.state == 'published' %> · <%= link_to 'Read public story', read_article_path(@article.slug) %><% end %></p>
<% if ArticlePolicy.new(current_author, @article).update? && @article.state != 'published' %><%= link_to 'Edit story', edit_article_path(@article) %><% end %>
<% if %w[draft changes_requested].include?(@article.state) && ArticlePolicy.new(current_author, @article).update? %><section><h2>Request review</h2><%= form_with url: submit_article_path(@article) do |f| %><%= f.label :reviewer_id, 'Editor' %><%= f.select :reviewer_id, current_organization.memberships.where(role: 'editor').includes(:author).map { |m| [m.author.name, m.author_id] } %> <%= f.submit 'Submit latest revision' %><% end %></section><% end %>
<% if editor? && %w[approved scheduled].include?(@article.state) %><section><h2>Publish</h2><%= button_to 'Publish now', publish_article_path(@article) %><% if @article.state == 'approved' %><%= form_with url: schedule_article_path(@article) do |f| %><%= f.label :scheduled_at, 'Schedule (UTC)' %><%= f.datetime_local_field :scheduled_at, required: true %> <%= f.submit 'Schedule publication' %><% end %><% end %><p><%= @article.scheduled_at %></p></section><% end %>
<h2>Revision history</h2><% @revisions.each do |revision| %><section><h3>Revision <%= revision.number %> · <%= revision.title %></h3><p><%= revision.created_at.to_fs(:short) %></p><% revision.review_assignments.each do |assignment| %><p>Reviewer: <%= assignment.reviewer.name %> · <%= assignment.review_decision&.outcome || 'Awaiting decision' %></p><p><%= assignment.review_decision&.notes %></p><% if assignment.reviewer_id == current_author.id && !assignment.review_decision && @article.state == 'in_review' && @article.latest_revision.id == revision.id %><%= form_with url: decide_article_path(@article) do |f| %><%= f.hidden_field :assignment_id, value: assignment.id %><%= f.select :outcome, [['Approve', 'approved'], ['Request changes', 'changes_requested']] %><%= f.label :notes %><%= f.text_field :notes %> <%= f.submit 'Record decision' %><% end %><% end %><% end %></section><% end %>
