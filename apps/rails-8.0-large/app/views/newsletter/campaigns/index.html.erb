<h1>Newsletters</h1><% @campaigns.each do |campaign| %><section><%= link_to campaign.subject, newsletter_campaign_path(campaign) %> · <%= campaign.state %></section><% end %><%= render 'shared/pagination', size: @campaigns.size %><h2>Compose newsletter</h2><%= form_with url: newsletter_campaigns_path do |f| %><%= f.label :subject %><%= f.text_field :subject, required: true %><%= f.label :article_id, 'Featured story' %><%= f.select :article_id, @articles.map { |a| [a.title, a.id] } %> <%= f.submit 'Create preview' %><% end %>
