<h1><%= @campaign.subject %></h1><p><%= @campaign.publication.name %> · <%= @campaign.state %></p><section><h2><%= @campaign.article.title %></h2><%= simple_format @campaign.article.body.to_s.truncate(500) %></section><p><%= @campaign.recipients.count %> active subscribers before newsletter preference filtering.</p><% if @campaign.state == 'draft' %><%= button_to 'Send newsletter', send_campaign_newsletter_campaign_path(@campaign) %><% end %><%= button_to 'Finish queued deliveries', drain_newsletter_campaign_path(@campaign) %><h2>Delivery results</h2><table><thead><tr><th>Reader</th><th>State</th><th>Engagement</th></tr></thead><tbody><% @deliveries.each do |delivery| %><tr><td><%= link_to delivery.subscriber.name, subscriber_path(delivery.subscriber) %></td><td><%= delivery.state %></td><td><%= delivery.engagement_events.count %> events<% if delivery.state == 'delivered' %><%= button_to 'Record a click', engage_newsletter_campaign_path(@campaign, delivery_id: delivery.id, kind: 'click') %><% end %></td></tr><% end %></tbody></table><%= render 'shared/pagination', size: @deliveries.size %>
