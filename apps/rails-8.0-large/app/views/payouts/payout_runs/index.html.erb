<h1>Payout runs</h1><table><thead><tr><th>Period</th><th>Status</th><th>Statements</th></tr></thead><tbody><% @runs.each do |run| %><tr><td><%= link_to run.period_start.strftime('%B %Y'), payouts_payout_run_path(run) %></td><td><%= render StatusBadgeComponent.new(status: run.status) %></td><td><%= run.statements_count %></td></tr><% end %></tbody></table><%= render 'shared/pagination', size: @runs.size %>
<h2>Start a payout run</h2><%= form_with url: payouts_payout_runs_path do |f| %><%= f.label :period_start, 'Month' %><%= f.date_field :period_start, value: Date.current.prev_month.beginning_of_month, required: true %> <%= f.submit 'Start payout run' %><% end %>
