<h1>Payees</h1><table><thead><tr><th>Name</th><th>Type</th><th>Method</th><th>Status</th></tr></thead><tbody><% @payees.each do |payee| %><tr><td><%= link_to payee.display_name, payouts_payee_path(payee) %></td><td><%= payee.payouts_agency_profile? ? 'Agency' : 'Individual' %></td><td><%= payee.payout_method.humanize %></td><td><%= render StatusBadgeComponent.new(status: payee.status) %></td></tr><% end %></tbody></table><%= render 'shared/pagination', size: @payees.size %>
<h2>Add individual payee</h2><%= form_with url: payouts_payees_path do |f| %><%= f.hidden_field :kind, value: 'individual' %><%= f.label :author_id, 'Author' %><%= f.select :author_id, @authors.map { |a| [a.name, a.id] } %><%= f.label :legal_name %><%= f.text_field :legal_name, required: true %><%= f.label :tax_id %><%= f.text_field :tax_id %><%= f.label :payout_method %><%= f.select :payout_method, [['Bank', 'bank'], ['International bank', 'international_bank'], ['Wallet', 'wallet']] %><%= f.label :account_last_four, 'Account last four' %><%= f.text_field :account_last_four, maxlength: 4 %><%= f.label :iban_last_four, 'IBAN last four (international)' %><%= f.text_field :iban_last_four, maxlength: 4 %><%= f.label :swift_code, 'SWIFT code (international)' %><%= f.text_field :swift_code %><%= f.label :wallet_handle, 'Wallet handle (wallet)' %><%= f.text_field :wallet_handle %> <%= f.submit 'Add individual payee' %><% end %>
<h2>Add agency payee</h2><%= form_with url: payouts_payees_path do |f| %><%= f.hidden_field :kind, value: 'agency' %><%= f.label :name, 'Agency name' %><%= f.text_field :name, required: true %><%= f.label :contact_email %><%= f.email_field :contact_email, required: true %><%= f.label :representations_attributes_0_author_id, 'Represented author' %><%= f.select 'representations_attributes[0][author_id]', @authors.map { |a| [a.name, a.id] }, include_blank: true %><%= f.label :representations_attributes_1_author_id, 'Second represented author' %><%= f.select 'representations_attributes[1][author_id]', @authors.map { |a| [a.name, a.id] }, include_blank: true %> <%= f.submit 'Add agency payee' %><% end %>
