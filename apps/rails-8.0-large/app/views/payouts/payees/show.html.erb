<h1><%= @payee.display_name %></h1><p><%= @payee.payouts_agency_profile? ? 'Agency' : 'Individual' %> · <%= @payee.payout_method.humanize %> · <%= @payee.currency %> · <%= render StatusBadgeComponent.new(status: @payee.status) %></p>
<% if @payee.payouts_agency_profile? %><section><p>Contact: <%= @payee.profile.contact_email %></p><p>Represents: <%= @payee.profile.authors.map(&:name).to_sentence.presence || 'no authors yet' %></p></section><% else %><section><p>Legal name: <%= @payee.profile.legal_name %></p><p class="muted">Account ending <%= @payee.profile.account_last_four.presence || 'not set' %></p></section><% end %>
<h2>Statements</h2><table><thead><tr><th>Period</th><th>Status</th><th>Total</th></tr></thead><tbody><% @statements.each do |statement| %><tr><td><%= link_to statement.payout_run.period_start.strftime('%B %Y'), payouts_statement_path(statement) %></td><td><%= render StatusBadgeComponent.new(status: statement.status) %></td><td><%= render MoneyComponent.new(cents: statement.total_cents, currency: statement.currency) %></td></tr><% end %></tbody></table>
