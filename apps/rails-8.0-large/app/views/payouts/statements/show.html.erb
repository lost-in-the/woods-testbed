<h1>Statement for <%= @statement.payee.display_name %></h1><p><%= @statement.payout_run.period_start.strftime('%B %Y') %> · <%= render StatusBadgeComponent.new(status: @statement.status) %> · <%= render MoneyComponent.new(cents: @statement.total_cents, currency: @statement.currency) %><% if @statement.hold_reason %> · <span class="muted">Held: <%= @statement.hold_reason.humanize %></span><% end %></p>
<% if @statement.transfer %><section>Transfer: <%= render StatusBadgeComponent.new(status: @statement.transfer.state) %> · <%= render MoneyComponent.new(cents: @statement.transfer.amount_cents, currency: @statement.transfer.currency) %></section><% end %>
<h2>Earnings</h2><table><thead><tr><th>Date</th><th>Description</th><th>Kind</th><th>Amount</th></tr></thead><tbody><% @statement.earnings.each do |earning| %><tr><td><%= earning.earned_on %></td><td><%= earning.description %></td><td><%= earning.kind %></td><td><%= render MoneyComponent.new(cents: earning.amount_cents, currency: earning.currency) %></td></tr><% end %></tbody></table>
<% if @breakdown %><h2>Breakdown by kind</h2><table><thead><tr><th>Kind</th><th>Count</th><th>Gross</th></tr></thead><tbody><% @breakdown.each do |row| %><tr><td><%= row[:kind] %></td><td><%= row[:count] %></td><td><%= render MoneyComponent.new(cents: row[:gross_cents], currency: @statement.currency) %></td></tr><% end %></tbody></table><% else %><p><%= link_to 'Preview breakdown', payouts_statement_path(@statement, preview: '1') %></p><% end %>
