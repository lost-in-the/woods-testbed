<h1><%= @subscriber.name %></h1><p><%= @subscriber.email %></p><h2>Subscriptions</h2><% @subscriber.subscriptions.includes(:plan, :history).each do |subscription| %><section><strong><%= subscription.plan.name %></strong> · <%= subscription.state %> · Renews <%= subscription.renews_at.to_date %><%= button_to 'Cancel subscription', cancel_subscriber_path(@subscriber, subscription_id: subscription.id) if subscription.state == 'active' %><% subscription.history.each do |change| %><p><small><%= change.event %> · <%= change.created_at.to_fs(:short) %></small></p><% end %></section><% end %><%= form_with url: subscribe_subscriber_path(@subscriber) do |f| %><%= f.label :plan_id, 'Subscribe to a publication' %><%= f.select :plan_id, @plans.map { |p| ["#{p.publication.name} / #{p.name} ($#{p.amount_cents / 100.0})", p.id] } %> <%= f.submit 'Activate subscription' %><% end %>
<h2>Invoices</h2><% @subscriber.invoices.each do |invoice| %><p><%= link_to invoice.reference, billing_invoice_path(invoice) %> · <%= invoice.settled_at ? 'Paid' : 'Outstanding' %></p><% end %><h2>Support history</h2><% @subscriber.tickets.each do |ticket| %><p><%= link_to ticket.title, support_ticket_path(ticket) %> · <%= ticket.state %></p><% end %>
<h2>Open a ticket</h2><%= form_with url: support_tickets_path do |f| %><%= f.hidden_field :subscriber_id, value: @subscriber.id %><%= f.label :title %><%= f.text_field :title, required: true %><%= f.label :invoice_id, 'Related invoice (optional)' %><%= f.select :invoice_id, @subscriber.invoices.map { |i| [i.reference, i.id] }, include_blank: true %> <%= f.submit 'Open ticket' %><% end %>
