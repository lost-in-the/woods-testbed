<h1>Subscribers</h1><table><thead><tr><th>Name</th><th>Email</th></tr></thead><tbody><% @subscribers.each do |subscriber| %><tr><td><%= link_to subscriber.name, subscriber_path(subscriber) %></td><td><%= subscriber.email %></td></tr><% end %></tbody></table><%= render 'shared/pagination', size: @subscribers.size %><h2>Add subscriber</h2><%= form_with scope: :subscriber, url: subscribers_path do |f| %><%= f.label :name %><%= f.text_field :name, required: true %><%= f.label :email %><%= f.email_field :email, required: true %> <%= f.submit 'Add subscriber' %><% end %>
