<h1>Your publishing desk</h1><p class="muted">Stories in progress, reader relationships, and the work that connects them.</p>
<div class="metrics"><div class="card">Awaiting review<strong class="metric"><%= @report.review_backlog.count %></strong><%= link_to 'Open review queue', articles_path(state: 'in_review') %></div><% if editor? %><div class="card">Overdue invoices<strong class="metric">$<%= '%.2f' % (@report.overdue_cents / 100.0) %></strong><%= link_to 'Review invoices', billing_invoices_path %></div><div class="card">Newsletter outcomes<% @report.newsletter_outcomes.each do |state, count| %><div><%= state.humanize %>: <strong><%= count %></strong></div><% end %></div><% end %></div>
<%= link_to 'Write a story →', new_article_path %>
<% if editor? %><section><h2>Scheduled work</h2><p>Publish due stories and create invoices for renewals that are due.</p><%= button_to 'Run due work', run_due_path %></section>
<h2>Recent activity</h2><% @events.each do |event| %><p><span class="badge"><%= event.action %></span> <%= event.subject_type %> #<%= event.subject_id %> · <%= event.created_at.to_fs(:short) %></p><% end %>
<h2>Webhook delivery</h2><p class="muted">Local simulation: first attempt fails; retry succeeds.</p><% @webhooks.each do |delivery| %><p>#<%= delivery.id %> <%= delivery.state %> · <%= delivery.attempts %> attempts <%= button_to 'Attempt delivery', retry_webhook_path(delivery) unless delivery.state == 'delivered' %></p><% end %><% end %>
