source "https://rubygems.org"
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

# The 3.0 LINE, not an exact patch. The Dockerfile tracks ruby:3.0-slim, which
# floats: it shipped 3.0.6 when this variant was written and now ships 3.0.7, and
# an exact pin makes Bundler refuse to run with
#   "Your Ruby version is 3.0.7, but your Gemfile specified 3.0.6"
# — before installing anything, so the container never boots. What this variant
# exists to pin is the supported *floor* (Ruby 3.0 / Rails 6.0), which a
# pessimistic constraint expresses correctly.
ruby "~> 3.0.0"

# Rails 6.0.x — the supported floor (railties >= 6.0, woods #135). Change the
# pin here (not anywhere else) to bump within the 6.0 line.
gem "rails", "~> 6.0.0"

# The MySQL twin of rails-6.0: identical app, MySQL adapter. This is the only
# variant with a real mysql2 handle, so backend-dialect contracts (gem PR
# lost-in-the/woods#248) have a lane that reaches a live MySQL server.
gem "mysql2", "~> 0.5"
gem "puma", "~> 4.3"
gem "bootsnap", ">= 1.4.2", require: false

# Rails < 7.1 relies on concurrent-ruby's implicit `require "logger"`, which
# 1.3.5 removed; pin below it so the app boots on Ruby 3.x.
gem "concurrent-ruby", "< 1.3.5"

group :development, :test do
  gem "byebug", platforms: %i[mri mingw x64_mingw]
end

# Woods gem — bind-mounted by the testbed compose file.
gem "woods", path: "/woods-gem"
